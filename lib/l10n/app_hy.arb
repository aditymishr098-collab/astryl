  "factEarth2": "Երկիրը կատարյալ գնդակ չէ։ Պտտվելու պատճառով հասարակածի մոտ մի փոքր ուռած է։",
  "factMars1": "Մարսի Օլիմպոս լեռը Արեգակնային համակարգի ամենաբարձր հրաբուխն է՝ Էվերեստից մոտ երկուսուկես անգամ բարձր։",
  "factMars2": "Մարսի վրա մայրամուտները կապույտ են երևում։",
  "factJupiter1": "Յուպիտերի զանգվածը երկու անգամից ավելի մեծ է մնացած բոլոր մոլորակների միասին վերցրած զանգվածից։",
  "factJupiter2": "Մեծ կարմիր բիծը Երկրից մեծ մրրիկ է, որին մարդիկ հետևում են ավելի քան 150 տարի։",
  "factSaturn1": "Սատուրնը իր չափի համար այնքան թեթև է, որ ջրի վրա կլողար, եթե բավականաչափ մեծ լոգարան գտնվեր։",
  "factSaturn2": "Սատուրնի օղակները շատ լայն են, բայց շատ բարակ՝ որոշ տեղերում ընդամենը մոտ տաս մետր հաստությամբ։",
  "factUranus1": "Ուրանը Արեգակի շուրջ պտտվում է կողքի վրա գլորվելով՝ մոտ 98 աստիճանով թեքված։",
  "factUranus2": "Ուրանը առաջին մոլորակն էր, որ հայտնաբերվեց աստղադիտակով։ Ուիլյամ Հերշելը նկատեց այն 1781 թվականին։",
  "factNeptune1": "Նեպտունի վրա ամենաարագ քամիներն են բոլոր մոլորակների մեջ՝ ժամում ավելի քան 2000 կմ։",
  "factNeptune2": "Նեպտունը գտնվեց մաթեմատիկայով, նախքան որևէ մեկը տեսներ այն․ 1846 թվականին աստղագետները հաշվեցին, թե որտեղ պետք է լինի։",
  "factMoon1": "Լուսինը ամեն տարի Երկրից հեռանում է մոտ 3,8 սանտիմետրով։",
  "factMoon2": "Մենք միշտ տեսնում ենք Լուսնի նույն կողմը, որովհետև Երկրի շուրջ ամեն պտույտի ընթացքում այն ճիշտ մեկ անգամ է պտտվում իր առանցքի շուրջ։",
  "factPluto1": "Պլուտոնի վրա մեկ տարին տևում է մոտ 248 երկրային տարի։",
  "factPluto2": "Պլուտոնի վրա կա սառած ազոտից կազմված սրտաձև հսկայական դաշտավայր։",
  "factIo1": "Իոն մեր ճանաչած ամենահրաբխային աշխարհն է՝ հարյուրավոր գործող հրաբուխներով։",
  "factIo2": "Յուպիտերի ձգողությունը սեղմում և ձգում է Իոյին, և դրանից առաջացած ջերմությունը սնում է նրա հրաբուխները։",
  "factEuropa1": "Սառցե ընդերքի տակ Եվրոպան հավանաբար պարունակում է Երկրի բոլոր օվկիանոսների ջրի մոտ կրկնակին։",
  "factEuropa2": "Եվրոպան Երկրից դուրս կյանք փնտրելու լավագույն վայրերից է։ «Եվրոպա Կլիպեր» սարքը դեպի այնտեղ է թռչում։",
  "factGanymede1": "Գանիմեդը Արեգակնային համակարգի ամենամեծ արբանյակն է։ Այն նույնիսկ Մերկուրիից մեծ է։",
  "factGanymede2": "Գանիմեդը միակ արբանյակն է, որի մասին հայտնի է, որ ունի սեփական մագնիսական դաշտ։",
  "factCallisto1": "Կալիստոն Արեգակնային համակարգի ամենաշատ խառնարաններ ունեցող վայրերից է, և նրա մակերևույթը շատ հին է։",
  "factCallisto2": "Կալիստոն Յուպիտերից բավականաչափ հեռու է, որ նրա ուժեղ ճառագայթումից քիչ է ստանում, ուստի գիտնականները այն առաջարկել են ապագա բազայի համար։",
  "factTitan1": "Տիտանը միակ արբանյակն է խիտ մթնոլորտով։ Նրա մակերևույթին օդի ճնշումը Երկրի վրայից բարձր է։",
  "factTitan2": "Տիտանի վրա կան գետեր և լճեր, բայց դրանցում ջուր չէ, այլ հեղուկ մեթան և էթան։",
  "factEnceladus1": "Էնցելադը հարավային բևեռի մոտ գտնվող ճեղքերից սառույցի և ջրային գոլորշու շիթեր է արձակում տիեզերք։",
  "factEnceladus2": "Էնցելադի շիթերը սնում են Սատուրնի E օղակը։",
  "factTriton1": "Տրիտոնը Նեպտունի շուրջ պտտվում է հակառակ ուղղությամբ, ուստի հավանաբար թզուկ մոլորակ էր, որին Նեպտունը գրավել է։",
  "factTriton2": "Մոտ −235 °C-ով Տրիտոնը Արեգակնային համակարգի ամենացուրտ վայրերից է, որտեղ ջերմաստիճան է չափվել։",
