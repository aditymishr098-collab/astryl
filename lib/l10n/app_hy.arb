  "missionsCardHint": "Հայտնի առաքելություններ ժամանակի ընթացքում",
  "missionSputnik1": "Առաջին արհեստական արբանյակը։ Լողափի գնդակի չափ այս մետաղական գունդը մոտ երեք ամիս պտտվեց Երկրի շուրջ։ Նրա ազդանշանը լսվում էր ռադիոյով, և սկսվեց տիեզերական դարաշրջանը։",
  "missionVostok1": "Յուրի Գագարինը դարձավ տիեզերք թռած առաջին մարդը։ Նա մոտ 108 րոպեում մեկ անգամ պտտվեց Երկրի շուրջ։",
  "missionApollo11": "Նիլ Արմսթրոնգն ու Բազ Օլդրինը վայրէջք կատարեցին Հանգստության ծովում և դարձան Լուսնի վրա քայլած առաջին մարդիկ։ Մայքլ Քոլինզը նրանց սպասում էր ուղեծրում։",
  "missionVenera7": "Առաջին սարքը, որը վայրէջք կատարեց մեկ այլ մոլորակի վրա և ազդանշան ուղարկեց։ Այն Վեներայից տվյալներ էր ուղարկում մոտ 23 րոպե՝ ջարդող շոգի մեջ։",
  "missionViking1": "Այն վայրէջք կատարեց Մարսի վրա և այնտեղ աշխատեց վեց տարուց ավելի՝ ուղարկելով մեկ այլ մոլորակի մակերևույթից լուսանկարների և եղանակի զեկույցների առաջին երկար շարքը։",
  "missionVoyager1": "Արձակվել է 1977 թվականին, անցել է Յուպիտերի և Սատուրնի մոտով և 2012 թվականին մտել աստղերի միջև տարածություն։ Սա Երկրից ամենահեռու մարդու ստեղծած օբյեկտն է։",
  "missionHubble": "Արձակվել է 1990 թվականին, դիտում է Տիեզերքը Երկրի օդից վերև։ Նրա հստակ նկարները օգնեցին չափել Տիեզերքի տարիքը և ցույց տվեցին հազարավոր հեռավոր գալակտիկաներ։",
  "missionHuygens": "Հյուգենսը՝ Կասինիի տարած զոնդը, պարաշյուտով իջավ Սատուրնի արբանյակ Տիտանի վրա։ Դա արտաքին Արեգակնային համակարգի առաջին վայրէջքն էր, և այն մակերևույթից նկարներ ուղարկեց։",
  "missionCuriosity": "Մեքենայի չափ այս մարսագնացը վայրէջք կատարեց Գեյլի խառնարանում՝ հրթիռով աշխատող «երկնային կռունկի» օգնությամբ։ Այն պարզեց, որ Մարսը ժամանակին կյանքի համար հարմար պայմաններ է ունեցել։",
  "missionMangalyaan": "Հնդկաստանի Mars Orbiter առաքելությունը Մարսի ուղեծիր հասավ առաջին փորձից, ինչը ոչ մի երկրի չէր հաջողվել, և շատ ցածր ծախսով։",
  "missionRosetta": "Ռոզետայի վայրէջքային սարք Ֆիլեն վայրէջք կատարեց 67P/Չուրյումով–Գերասիմենկո գիսաստղի վրա՝ գիսաստղի վրա առաջին վայրէջքը։ Ռոզետան ինքը երկու տարի պտտվեց գիսաստղի շուրջ։",
  "missionNewhorizons": "Ինը տարվա ճանապարհորդությունից հետո այն անցավ Պլուտոնի մոտով և առաջին անգամ մեզ ցույց տվեց սառցե լեռներ և սրտաձև հսկայական հարթավայր։",
  "missionPerseverance": "Perseverance մարսագնացը վայրէջք կատարեց Ջեզերո խառնարանում՝ հին կյանքի հետքեր փնտրելու և ապարների նմուշներ հավաքելու համար։ Նրա Ingenuity ուղղաթիռը կատարեց մեկ այլ մոլորակի վրա առաջին ղեկավարվող թռիչքը։",
  "missionJwst": "Ամենամեծ տիեզերական աստղադիտակն ունի 6,5 մետրանոց ոսկեգույն հայելի և դիտում է երկինքը ինֆրակարմիր լույսով 1,5 միլիոն կմ հեռավորությունից։ Այն տեսնում է առաջին գալակտիկաներից մի քանիսը։",
  "missionChandrayaan3": "Հնդկաստանը դարձավ Լուսնի վրա մեղմ վայրէջք կատարած չորրորդ երկիրը և առաջինը՝ նրա հարավային բևեռի մոտ։ Vikram վայրէջքային սարքը կրում էր Pragyan մարսագնացը։",
